{
  "name": "road-rash",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205\" next build",
    "start": "next start",
    "lint": "eslint",
    "build:lambdas": "node services/build.mjs",
    "test": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205\" vitest run",
    "test:watch": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --disable-warning=DEP0205\" vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-amplify/adapter-nextjs": "^1.7.3",
    "aws-amplify": "^6.17.0",
    "next": "16.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1063.0",
    "@aws-sdk/client-s3": "^3.1063.0",
    "@aws-sdk/client-ssm": "^3.1063.0",
    "@aws-sdk/lib-dynamodb": "^3.1063.0",
    "@aws-sdk/s3-request-presigner": "^3.1063.0",
    "@tailwindcss/postcss": "^4",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
