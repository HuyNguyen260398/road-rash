# Copy to .env.local and fill in. Never commit real secrets.
# These are placeholders for the planned integrations (see docs/road-rash-plan.md).

# Google Gemini API key — used ONLY server-side (Lambda). In production this is
# stored as an Amplify/SSM secret, not an env var shipped to the browser.
GEMINI_API_KEY=

# Google OAuth client (configured in Google Cloud Console; wired into Cognito).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
