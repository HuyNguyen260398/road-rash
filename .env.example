# Copy to .env.local and fill in. Never commit real secrets.
# These are placeholders for the planned integrations (see docs/road-rash-plan.md).

# Google Gemini API key — used ONLY server-side (Lambda). In production this is
# stored as an Amplify/SSM secret, not an env var shipped to the browser.
GEMINI_API_KEY=

# Google OAuth client (configured in Google Cloud Console; wired into Cognito).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Client-side Amplify / Cognito config (browser-safe NEXT_PUBLIC_*) ------
# In deployed envs these are populated by Amplify Hosting from Terraform Cognito
# outputs (infra/envs/*). For local `pnpm dev` against a real pool, copy the
# `terraform output` values here.
# Region is injected by Terraform in deployed envs (part of the M0 env-var
# contract) and consumed by Amplify Storage/S3 in a later milestone (M5).
# Amplify Auth derives its region from the pool IDs, so it is unused for sign-in.
NEXT_PUBLIC_AWS_REGION=ap-southeast-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=
# Hosted UI domain host, no protocol, e.g. road-rash-staging.auth.<region>.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
# App origin used for OAuth redirects on the server; the client uses window.origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
